# Spotify API Credentials
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Optional server settings
# HOST=127.0.0.1      # set to 0.0.0.0 only if another device must reach the app; this exposes your Spotify token on the network
# PORT=5004
# FLASK_DEBUG=1       # auto-reload and debugger for local development; never on a networked device
